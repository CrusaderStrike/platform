# Server
NODE_ENV=development
PORT=3000
PUBLIC_WEB_ORIGIN=https://crusaderstrike.com
PUBLIC_API_ORIGIN=https://api.crusaderstrike.com
# Comma-separated browser origins allowed for credentialed CORS
CORS_ORIGINS=https://crusaderstrike.com,https://www.crusaderstrike.com,http://localhost:8080

# Postgres
DATABASE_URL=postgres://crusaderstrike:crusaderstrike@127.0.0.1:5432/crusaderstrike

# Session cookie signing / id entropy (32+ random bytes, hex or base64)
SESSION_SECRET=replace-with-32-plus-bytes-of-entropy

# AES-256-GCM key for Blizzard tokens at rest (32 bytes as 64 hex chars)
# Generate: openssl rand -hex 32
TOKEN_ENC_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Blizzard OAuth (platform#10). Default false; set true only for local/dev mock.
# Startup fails if NODE_ENV=production and BLIZZARD_MOCK=true.
BLIZZARD_MOCK=false
BLIZZARD_CLIENT_ID=
BLIZZARD_CLIENT_SECRET=
# Comma-separated Forever regions to sync (us, eu, kr, tw). Default: us
BLIZZARD_REGIONS=us
# Optional primary region override (must be in BLIZZARD_REGIONS). Defaults to first entry.
# BLIZZARD_REGION=us
# Redirect URI registered on the Battle.net client (must match exactly)
BLIZZARD_REDIRECT_URI=https://api.crusaderstrike.com/api/v1/auth/blizzard/callback
